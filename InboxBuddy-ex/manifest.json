{
  "name": "InboxBuddy",
  "description": "Email reply assistant Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://localhost:8080/*",
    "https://inboxbuddy-api.onrender.com/*",
    "*://mail.google.com/*"
  ],
  "action": {
    "default_title": "InboxBuddy"
  },
  "content_scripts": [
    {
      "js": [
        "main.js"
      ],
      "matches": [
        "*://mail.google.com/*"
      ],
      "css": ["main.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "icons/*" ],
      "matches": [ "*://mail.google.com/*" ]
    }
  ]
}
